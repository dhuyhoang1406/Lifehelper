POSTGRES_USER=lifehelper
POSTGRES_PASSWORD=lifehelper
POSTGRES_DB=lifehelper
POSTGRES_PORT=5432
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=lifehelper-identity
JWT_AUDIENCE=lifehelper-mobile
REDIS_PORT=6379
LOCALSTACK_PORT=4566
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=lifehelper-local
SQS_QUEUE_NAME=lifehelper-events
SQS_DLQ_NAME=lifehelper-events-dlq

IDENTITY_PORT=3001
PRODUCTIVITY_PORT=3002
AI_PORT=3003
AI_PROVIDER=ollama
AI_MODEL=llama3.2
AI_BASE_URL=http://host.docker.internal:11434
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONTEXT_MESSAGES=50
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_MS=250
# Required only when AI_PROVIDER=cloudflare:
# Set AI_BASE_URL=https://api.cloudflare.com/client/v4 and AI_MODEL to a supported Workers AI model.
# Example: AI_MODEL=@cf/zai-org/glm-4.7-flash
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
DOCUMENT_PORT=3004
NOTIFICATION_PORT=3005
ANALYTICS_PORT=3006
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
