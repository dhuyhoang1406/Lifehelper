POSTGRES_USER=lifehelper
POSTGRES_PASSWORD=lifehelper
POSTGRES_DB=lifehelper
POSTGRES_PORT=5432
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=lifehelper-identity
JWT_AUDIENCE=lifehelper-mobile
REDIS_PORT=6379
LOCALSTACK_PORT=4566
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=lifehelper-local
SQS_QUEUE_NAME=lifehelper-events
SQS_DLQ_NAME=lifehelper-events-dlq

IDENTITY_PORT=3001
PRODUCTIVITY_PORT=3002
AI_PORT=3003
AI_PROVIDER=ollama
AI_MODEL=llama3.2
AI_BASE_URL=http://host.docker.internal:11434
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONTEXT_MESSAGES=50
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_MS=250
PRODUCTIVITY_SERVICE_URL=http://productivity-service:3002
PRODUCTIVITY_TIMEOUT_MS=5000
AI_ACTION_CONFIRM_TTL_SECONDS=600
# Required only when AI_PROVIDER=cloudflare:
# Set AI_BASE_URL=https://api.cloudflare.com/client/v4 and AI_MODEL to a supported Workers AI model.
# Example: AI_MODEL=@cf/zai-org/glm-4.7-flash
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
DOCUMENT_PORT=3004
NOTIFICATION_PORT=3005
ANALYTICS_PORT=3006
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

DOCUMENT_S3_BUCKET=lifehelper-documents
DOCUMENT_S3_PUBLIC_ENDPOINT=http://localhost:4566
DOCUMENT_ALLOWED_EXTENSIONS=txt,md,pdf
DOCUMENT_MAX_FILE_BYTES=10485760
DOCUMENT_MAX_STORAGE_BYTES=104857600
DOCUMENT_MAX_DOCUMENTS=100
DOCUMENT_UPLOAD_EXPIRY_SECONDS=300
DOCUMENT_DOWNLOAD_EXPIRY_SECONDS=60
DOCUMENT_STORAGE_TIMEOUT_MS=10000
DOCUMENT_STORAGE_MAX_ATTEMPTS=2
DOCUMENT_STORAGE_MAX_CONCURRENT_READS=2

# Durable Document processing (stages arrive in Branches 4-5)
DOCUMENT_WORKER_ENABLED=true
DOCUMENT_WORKER_CONCURRENCY=2
DOCUMENT_WORKER_POLL_MS=1000
DOCUMENT_WORKER_LEASE_MS=60000
DOCUMENT_WORKER_SHUTDOWN_MS=5000
DOCUMENT_PROCESSING_TIMEOUT_MS=30000
DOCUMENT_PROCESSING_MAX_ATTEMPTS=3
DOCUMENT_PROCESSING_RETRY_BASE_MS=500
DOCUMENT_PROCESSING_RETRY_MAX_MS=30000
DOCUMENT_PROCESSING_MAX_CHUNKS=1000
DOCUMENT_PROCESSING_MAX_TEXT_CHARS=1000000
DOCUMENT_PROCESSING_MAX_VECTOR_VALUES=1048576

# Branch 4: bounded extraction and conservative token budgets
DOCUMENT_EXTRACTION_MAX_PAGES=100
DOCUMENT_EXTRACTION_MAX_EXPANSION_RATIO=100
DOCUMENT_PARSER_TIMEOUT_MS=10000
DOCUMENT_PARSER_MEMORY_MB=128
DOCUMENT_CHUNK_TARGET_TOKENS=512
DOCUMENT_CHUNK_OVERLAP_TOKENS=64

# Document embeddings: independent from AI generation, no paid fallback.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3:567m
EMBEDDING_MODEL_VERSION=7907646426070047a77226ac3e684fbbe8410524f7b4a74d02837e43f2146bab
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_INPUT_TOKENS=8192
EMBEDDING_TIMEOUT_MS=10000
EMBEDDING_MAX_ATTEMPTS=2
