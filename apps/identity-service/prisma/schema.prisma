generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum OAuthProvider {
  GOOGLE
}

model User {
  id              String          @id @db.Uuid
  email           String          @unique @db.VarChar(255)
  passwordHash    String?         @map("password_hash") @db.VarChar(255)
  displayName     String          @map("display_name") @db.VarChar(120)
  avatarUrl       String?         @map("avatar_url")
  status          UserStatus
  emailVerifiedAt DateTime?       @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?       @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime        @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz(6)
  oauthAccounts   OAuthAccount[]
  deviceSessions  DeviceSession[]
  refreshTokens   RefreshToken[]

  @@index([status])
  @@map("users")
}

model OAuthAccount {
  id             String        @id @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id") @db.VarChar(255)
  providerEmail  String?       @map("provider_email") @db.VarChar(255)
  createdAt      DateTime      @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @map("updated_at") @db.Timestamptz(6)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model DeviceSession {
  id            String         @id @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  deviceId      String         @map("device_id") @db.VarChar(255)
  deviceName    String?        @map("device_name") @db.VarChar(120)
  platform      DevicePlatform
  pushToken     String?        @map("push_token")
  lastActiveAt  DateTime       @map("last_active_at") @db.Timestamptz(6)
  revokedAt     DateTime?      @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime       @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @map("updated_at") @db.Timestamptz(6)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@unique([userId, deviceId])
  @@index([userId, revokedAt])
  @@map("device_sessions")
}

model RefreshToken {
  id              String        @id @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  deviceSessionId String        @map("device_session_id") @db.Uuid
  tokenHash       String        @unique @map("token_hash") @db.VarChar(255)
  tokenFamilyId   String        @map("token_family_id") @db.Uuid
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime?     @map("used_at") @db.Timestamptz(6)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  replacedById    String?       @map("replaced_by_id") @db.Uuid
  createdAt       DateTime      @map("created_at") @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceSession   DeviceSession @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)

  @@index([userId, tokenFamilyId])
  @@index([deviceSessionId])
  @@map("refresh_tokens")
}

model OutboxEvent {
  id            String    @id @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(120)
  aggregateType String    @map("aggregate_type") @db.VarChar(120)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  attemptCount  Int       @default(0) @map("attempt_count")
  lastError     String?   @map("last_error")

  @@index([processedAt, occurredAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
