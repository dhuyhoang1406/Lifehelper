NODE_ENV=development
SERVICE_NAME=identity-service
IDENTITY_PORT=3001
DATABASE_URL=postgresql://lifehelper:lifehelper@localhost:5432/lifehelper_identity?schema=public
REDIS_URL=redis://localhost:6379
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=lifehelper-local
SQS_QUEUE_NAME=lifehelper-events
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN_SECONDS=900
JWT_ISSUER=lifehelper-identity
JWT_AUDIENCE=lifehelper-mobile
REFRESH_TOKEN_TTL_SECONDS=2592000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
