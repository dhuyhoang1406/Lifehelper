generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETED
}

enum ProcessingGenerationStatus {
  EXTRACTED
  PROCESSING
  COMPLETE
  FAILED
}

enum ProcessingJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model Document {
  id                     String                  @id @db.Uuid
  userId                 String                  @map("user_id") @db.Uuid
  originalFilename       String                  @map("original_filename") @db.VarChar(255)
  storageFilename        String                  @map("storage_filename") @db.VarChar(255)
  mimeType               String                  @map("mime_type") @db.VarChar(120)
  sizeBytes              BigInt                  @map("size_bytes")
  s3Bucket               String                  @map("s3_bucket") @db.VarChar(255)
  s3Key                  String                  @unique @map("s3_key")
  status                 DocumentStatus
  checksumSha256         String?                 @map("checksum_sha256") @db.VarChar(64)
  processingError        String?                 @map("processing_error")
  createdAt              DateTime                @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz(6)
  processingGeneration   Int                     @default(0) @map("processing_generation")
  activeGeneration       Int?                    @map("active_generation")
  uploadExpiresAt        DateTime?               @map("upload_expires_at") @db.Timestamptz(6)
  storageVersionId       String?                 @map("storage_version_id") @db.VarChar(1024)
  expectedChecksumSha256 String?                 @map("expected_checksum_sha256") @db.VarChar(64)
  cleanup                DocumentCleanupTask?
  revision               Int                     @default(0)
  generations            DocumentGeneration[]    @relation("DocumentGenerations")
  active                 DocumentGeneration?     @relation("ActiveGeneration", fields: [id, activeGeneration], references: [documentId, generation], onDelete: NoAction, onUpdate: NoAction)
  chunks                 DocumentChunk[]
  jobs                   DocumentProcessingJob[]

  @@index([userId, status])
  @@index([userId, deletedAt, createdAt, id])
  @@map("documents")
}

model DocumentChunk {
  id                   String             @id @db.Uuid
  documentId           String             @map("document_id") @db.Uuid
  generation           Int                @default(1)
  locatorKind          String?            @map("locator_kind") @db.VarChar(10)
  locatorStart         Int?               @map("locator_start")
  locatorEnd           Int?               @map("locator_end")
  processingGeneration DocumentGeneration @relation(fields: [documentId, generation], references: [documentId, generation], onDelete: Cascade)
  chunkIndex           Int                @map("chunk_index")
  content              String
  tokenCount           Int?               @map("token_count")
  metadata             Json?
  createdAt            DateTime           @map("created_at") @db.Timestamptz(6)
  document             Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embedding            DocumentEmbedding?

  @@unique([documentId, generation, chunkIndex])
  @@map("document_chunks")
}

model DocumentEmbedding {
  id             String                 @id @db.Uuid
  chunkId        String                 @unique @map("chunk_id") @db.Uuid
  embeddingModel String                 @map("embedding_model") @db.VarChar(100)
  modelVersion   String                 @default("legacy") @map("model_version") @db.VarChar(100)
  dimensions     Int
  embedding      Unsupported("vector")?
  createdAt      DateTime               @map("created_at") @db.Timestamptz(6)
  chunk          DocumentChunk          @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@map("document_embeddings")
}

model DocumentGeneration {
  documentId           String                     @map("document_id") @db.Uuid
  generation           Int
  status               ProcessingGenerationStatus @default(PROCESSING)
  chunkCount           Int?                       @map("chunk_count")
  createdAt            DateTime                   @map("created_at") @db.Timestamptz(6)
  processingVersion    String?                    @map("processing_version") @db.VarChar(100)
  sourceChecksumSha256 String?                    @map("source_checksum_sha256") @db.VarChar(64)
  sourceVersionId      String?                    @map("source_version_id") @db.VarChar(1024)
  embeddingModel       String?                    @map("embedding_model") @db.VarChar(100)
  embeddingVersion     String?                    @map("embedding_version") @db.VarChar(100)
  embeddingDimensions  Int?                       @map("embedding_dimensions")
  embeddingSettings    Json?                      @map("embedding_settings")
  extractedAt          DateTime?                  @map("extracted_at") @db.Timestamptz(6)
  completedAt          DateTime?                  @map("completed_at") @db.Timestamptz(6)
  document             Document                   @relation("DocumentGenerations", fields: [documentId], references: [id], onDelete: Cascade)
  activeDocuments      Document[]                 @relation("ActiveGeneration")
  chunks               DocumentChunk[]
  job                  DocumentProcessingJob?

  @@id([documentId, generation])
  @@map("document_generations")
}

model DocumentProcessingJob {
  id                   String              @id @db.Uuid
  documentId           String              @map("document_id") @db.Uuid
  generation           Int
  status               ProcessingJobStatus @default(PENDING)
  attemptCount         Int                 @default(0) @map("attempt_count")
  leaseToken           Int                 @default(0) @map("lease_token")
  nextAttemptAt        DateTime            @map("next_attempt_at") @db.Timestamptz(6)
  leaseOwner           String?             @map("lease_owner") @db.VarChar(128)
  leaseExpiresAt       DateTime?           @map("lease_expires_at") @db.Timestamptz(6)
  reprocessKey         String?             @map("reprocess_key") @db.Uuid
  errorCode            String?             @map("error_code") @db.VarChar(100)
  createdAt            DateTime            @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @map("updated_at") @db.Timestamptz(6)
  document             Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  processingGeneration DocumentGeneration  @relation(fields: [documentId, generation], references: [documentId, generation], onDelete: Cascade)

  @@unique([documentId, generation])
  @@unique([documentId, reprocessKey])
  @@index([status, nextAttemptAt, id])
  @@index([status, leaseExpiresAt])
  @@map("document_processing_jobs")
}

model OutboxEvent {
  id            String    @id @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(120)
  aggregateType String    @map("aggregate_type") @db.VarChar(120)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  attemptCount  Int       @default(0) @map("attempt_count")
  lastError     String?   @map("last_error")

  @@index([processedAt, occurredAt])
  @@map("outbox_events")
}

model DocumentCleanupTask {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId     String?   @unique @map("document_id") @db.Uuid
  bucket         String?
  key            String?
  leaseOwner     String?   @map("lease_owner") @db.VarChar(128)
  leaseToken     Int       @default(0) @map("lease_token")
  leaseExpiresAt DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  errorCode      String?   @map("error_code") @db.VarChar(100)
  nextAttemptAt  DateTime  @map("next_attempt_at") @db.Timestamptz(6)
  attemptCount   Int       @default(0) @map("attempt_count")
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime  @map("created_at") @db.Timestamptz(6)
  document       Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([bucket, key])
  @@index([completedAt, nextAttemptAt])
  @@index([nextAttemptAt, id])
  @@map("document_cleanup_tasks")
}

model DocumentMaintenanceCursor {
  name      String   @id
  cursor    String?
  updatedAt DateTime @map("updated_at") @db.Timestamptz(6)

  @@map("document_maintenance_cursors")
}

model DocumentProcessingAudit {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId String    @map("document_id") @db.Uuid
  jobId      String    @map("job_id") @db.Uuid
  generation Int
  leaseToken Int       @map("lease_token")
  phase      String    @db.VarChar(16)
  status     String    @db.VarChar(16)
  startedAt  DateTime  @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  durationMs Int?      @map("duration_ms")
  metrics    Json?
  errorCode  String?   @map("error_code") @db.VarChar(100)

  @@unique([jobId, leaseToken])
  @@index([startedAt])
  @@index([documentId, startedAt])
  @@map("document_processing_audits")
}
