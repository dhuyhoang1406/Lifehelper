NODE_ENV=development
SERVICE_NAME=ai-service
AI_PORT=3003
AI_PROVIDER=ollama
AI_MODEL=llama3.2
AI_BASE_URL=http://localhost:11434
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_CONTEXT_MESSAGES=50
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_DELAY_MS=250
JWT_ACCESS_SECRET=replace-with-the-same-secret-as-identity-service
JWT_ISSUER=lifehelper-identity
JWT_AUDIENCE=lifehelper-mobile
# Required only when AI_PROVIDER=cloudflare:
# Set AI_BASE_URL=https://api.cloudflare.com/client/v4 and AI_MODEL to a supported Workers AI model.
# Example: AI_MODEL=@cf/zai-org/glm-4.7-flash
# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-api-token
DATABASE_URL=postgresql://lifehelper:lifehelper@localhost:5432/lifehelper_ai?schema=public
REDIS_URL=redis://localhost:6379
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=lifehelper-local
SQS_QUEUE_NAME=lifehelper-events
LOG_LEVEL=info
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
