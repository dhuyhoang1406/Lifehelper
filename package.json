{
  "name": "lifehelper",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm --filter './packages/**' --filter './apps/**' --if-present build",
    "test": "pnpm --filter './apps/**' --if-present test",
    "test:e2e": "pnpm --filter './apps/**' --if-present test:e2e",
    "test:persistence": "pnpm --filter './apps/*-service' --if-present test:persistence",
    "lint": "pnpm --filter './packages/**' --filter './apps/**' --if-present lint",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,js,json,yaml,yml,md}\" \"*.{json,yaml,yml,md}\"",
    "prisma:generate": "pnpm --filter './apps/*-service' --if-present prisma:generate",
    "db:generate": "pnpm prisma:generate",
    "db:migrate": "pnpm --filter './apps/*-service' --if-present db:migrate",
    "db:seed": "pnpm --filter './apps/*-service' --if-present db:seed",
    "db:reset": "pnpm --filter './apps/*-service' --if-present db:reset",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
